<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="sqlite3" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="..\bin\sqlite3" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Release\" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DSQLITE_MAKINGDLL" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Release32">
				<Option output="..\bin32\sqlite3" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Release32\" />
				<Option type="3" />
				<Option compiler="msvc8" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/MD" />
					<Add option="/EHc" />
					<Add option="/EHs" />
					<Add option="/O2" />
					<Add option="/Ox" />
					<Add option="/W3" />
					<Add option="/Zc:wchar_t" />
					<Add option="/DWIN32" />
					<Add option="/DNDEBUG" />
					<Add option="/DSQLITE_MAKINGDLL" />
				</Compiler>
				<Linker>
					<Add option="/INCREMENTAL:NO" />
				</Linker>
				<ExtraCommands>
					<Add after='mt.exe /nologo /manifest &quot;..\bin32\sqlite3.dll.manifest&quot; /outputresource:&quot;..\bin32\sqlite3.dll&quot;;2' />
				</ExtraCommands>
			</Target>
		</Build>
		<Unit filename="sqlite3.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="sqlite3.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<lib_finder disable_auto="1" />
			<debugger />
			<DoxyBlocks>
				<comment_style block="0" line="0" />
				<doxyfile_project />
				<doxyfile_build />
				<doxyfile_warnings />
				<doxyfile_output />
				<doxyfile_dot />
				<general />
			</DoxyBlocks>
		</Extensions>
	</Project>
</CodeBlocks_project_file>

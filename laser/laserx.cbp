<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="laserx" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="../bin/liblaser" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add directory="/usr/include/unicap" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Debug">
				<Option output="../bin/Debug/liblaser" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../bin/Debug" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
					<Add directory="/usr/include/unicap" />
				</Compiler>
			</Target>
		</Build>
		<Compiler>
			<Add directory="../gtime" />
			<Add directory="../trace" />
		</Compiler>
		<Unit filename="cam.cpp" />
		<Unit filename="cam.h" />
		<Unit filename="canny.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="canny.h" />
		<Unit filename="laserimg.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="laserimg.h" />
		<Unit filename="matrix.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="matrix.h" />
		<Unit filename="ovalfit.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="ovalfit.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>

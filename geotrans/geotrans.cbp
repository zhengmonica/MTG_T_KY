<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="geotrans" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="../bin/geotrans" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-DGEOTRANS_MAKINGDLL" />
					<Add directory="../sqlite3" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="sqlite3" />
					<Add directory="../bin" />
				</Linker>
			</Target>
			<Target title="Release32">
				<Option output="../bin32/geotrans" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release32" />
				<Option type="3" />
				<Option compiler="msvc8" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/MD" />
					<Add option="/EHc" />
					<Add option="/EHs" />
					<Add option="/O2" />
					<Add option="/Ox" />
					<Add option="/W3" />
					<Add option="/Zc:wchar_t" />
					<Add option="/DWIN32" />
					<Add option="/DNDEBUG" />
					<Add option="/DGEOTRANS_MAKINGDLL" />
					<Add directory="../sqlite3" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="sqlite3" />
					<Add directory="../bin32" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="geocent.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="geocent.h" />
		<Unit filename="geometry.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="geometry.h" />
		<Unit filename="geotrans.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="geotrans.h" />
		<Unit filename="matrix.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="matrix.h" />
		<Unit filename="tranmerc.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="tranmerc.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>

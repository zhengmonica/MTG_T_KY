<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="gtime" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Release">
				<Option output="../bin/libgtime" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-DBUILD_DLL" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Release32">
				<Option output="../bin32/gtime" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release32/" />
				<Option type="3" />
				<Option compiler="msvc8" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/MD" />
					<Add option="/EHc" />
					<Add option="/EHs" />
					<Add option="/Ox" />
					<Add option="/W3" />
					<Add option="/Zc:wchar_t" />
					<Add option="/DWIN32" />
					<Add option="/DNDEBUG" />
					<Add option="/DGTIME_MAKINGDLL" />
				</Compiler>
				<Linker>
					<Add library="Winmm" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-DGTIME_MAKING_DLL" />
		</Compiler>
		<Unit filename="gtime.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="gtime.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>

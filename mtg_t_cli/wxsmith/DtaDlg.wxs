<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxDialog" name="DtaDlg">
		<title>DTA</title>
		<centered>1</centered>
		<size>800,600</size>
		<pos_arg>1</pos_arg>
		<size_arg>1</size_arg>
		<style>wxCAPTION</style>
		<object class="wxStaticText" name="ID_STATICTEXT1" variable="StaticText1" member="yes">
			<label>中线数据</label>
			<pos>328,8</pos>
			<font>
				<size>12</size>
				<style>normal</style>
				<weight>bold</weight>
				<underlined>0</underlined>
				<family>swiss</family>
				<face>仿宋_GB2312</face>
			</font>
		</object>
		<object class="wxStaticLine" name="ID_STATICLINE1" variable="StaticLine1" member="yes">
			<pos>0,40</pos>
			<size>800,2</size>
		</object>
		<object class="wxNotebook" name="ID_NOTEBOOK1" variable="Notebook1" member="yes">
			<pos>0,42</pos>
			<size>800,496</size>
			<object class="notebookpage">
				<object class="wxPanel" name="ID_PANEL1" subclass="HorizonPanel" variable="panelHorizon" member="yes">
					<pos>146,136</pos>
				</object>
				<label>平曲线</label>
			</object>
			<object class="notebookpage">
				<object class="wxPanel" name="ID_PANEL2" subclass="VerticalPanel" variable="panelVertical" member="yes">
					<pos>149,10</pos>
				</object>
				<label>竖曲线</label>
			</object>
			<object class="notebookpage">
				<object class="wxPanel" name="ID_PANEL3" subclass="HOffPanel" variable="panelHOff" member="yes">
					<pos>166,22</pos>
				</object>
				<label>平偏</label>
			</object>
			<object class="notebookpage">
				<object class="wxPanel" name="ID_PANEL4" subclass="VOffPanel" variable="panelVOff" member="yes">
					<pos>219,21</pos>
				</object>
				<label>纵偏</label>
			</object>
		</object>
		<object class="wxStaticLine" name="ID_STATICLINE2" variable="StaticLine2" member="yes">
			<pos>0,540</pos>
			<size>800,2</size>
		</object>
		<object class="wxButton" name="wxID_OK" variable="Button1" member="yes">
			<label>退出</label>
			<pos>688,552</pos>
			<size>100,32</size>
			<handler function="OnBtnOk" entry="EVT_BUTTON" />
		</object>
		<object class="wxButton" name="ID_BUTTON1" variable="BtnCoord" member="yes">
			<label>坐标表</label>
			<pos>216,552</pos>
			<size>100,32</size>
			<handler function="OnBtnCoord" entry="EVT_BUTTON" />
		</object>
		<object class="wxButton" name="ID_BUTTON2" variable="BtnImport" member="yes">
			<label>导入</label>
			<pos>8,552</pos>
			<size>100,32</size>
			<handler function="OnBtnImport" entry="EVT_BUTTON" />
		</object>
		<object class="wxButton" name="ID_BUTTON3" variable="BtnExport" member="yes">
			<label>导出</label>
			<pos>112,552</pos>
			<size>100,32</size>
			<handler function="OnBtnExport" entry="EVT_BUTTON" />
		</object>
	</object>
</wxsmith>

            memDC.DrawLine(x1,0,x2,0);
            memDC.DrawLine(x1-1,0,x1-1,h);
        }
        else
        {
            c1=236;
            c2=236;
            c3=236;
            for(int i=0;i<h;i++)
            {
                memDC.SetPen(wxPen(wxColor(c1,c2,c3)));

    comStaticText6 = new wxStaticText(panelComm, wxID_ANY, _("."), wxPoint(x1+208,y1), wxDefaultSize, 0, _("wxID_ANY"));
    comTextCtrl1 = new wxMyTextCtrl(panelComm, wxID_ANY, wxEmptyString, wxPoint(x1+65,y1), wxSize(40,20), 0);

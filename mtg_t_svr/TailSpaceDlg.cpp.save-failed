    panelData = new wxPanel(panelMain, wxID_ANY, wxPoint(w+150,11), wxSize(w-150,h-88), wxTAB_TRAVERSAL, _T("wxID_ANY"));
    panelData->SetBackgroundColour(wxColor(239,239,239));
    x1=14;
    y1=9;
    w2=w1-x1*2-75;
    h2=h1-y1-15;

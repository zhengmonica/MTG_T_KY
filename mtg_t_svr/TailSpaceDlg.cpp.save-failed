    panelList->InsertColumn(i++,_("设备的理论地址"),wxLIST_FORMAT_CENTER,150);
    panelList->InsertColumn(i++,_("设备的当前地址"),wxLIST_FORMAT_CENTER,150);

    LoadData();
	//*)
}


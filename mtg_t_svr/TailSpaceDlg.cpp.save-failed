void TailSpaceDlg::OnMotionMeasButton(wxMouseEvent& event)
{
    int x=event.GetX();
    int y=event.GetY();
    if(y>figButton[ID_FIG_DIST_ADD].y && y<figButton[ID_FIG_DIST_ADD].y+figButton[ID_FIG_DIST_ADD].height)
    {
        if(x>figButton[ID_FIG_DIST_ADD].x && x<figButton[ID_FIG_DIST_ADD].x+figButton[ID_FIG_DIST_ADD].width)
        {
            motion=ID_FIG_DIST_ADD;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_EDI].y && y<figButton[ID_FIG_DIST_EDI].y+figButton[ID_FIG_DIST_EDI].height)
    {
        if(x>figButton[ID_FIG_DIST_EDI].x && x<figButton[ID_FIG_DIST_EDI].x+figButton[ID_FIG_DIST_EDI].width)
        {
            motion=ID_FIG_DIST_EDI;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_DEL].y && y<figButton[ID_FIG_DIST_DEL].y+figButton[ID_FIG_DIST_DEL].height)
    {
        if(x>figButton[ID_FIG_DIST_DEL].x && x<figButton[ID_FIG_DIST_DEL].x+figButton[ID_FIG_DIST_DEL].width)
        {
            motion=ID_FIG_DIST_DEL;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_OBTAIN_ADDRESS].y && y<figButton[ID_FIG_DIST_OBTAIN_ADDRESS].y+figButton[ID_FIG_DIST_OBTAIN_ADDRESS].height)
    {
        if(x>figButton[ID_FIG_DIST_OBTAIN_ADDRESS].x && x<figButton[ID_FIG_DIST_OBTAIN_ADDRESS].x+figButton[ID_FIG_DIST_OBTAIN_ADDRESS].width)
        {
            motion=ID_FIG_DIST_OBTAIN_ADDRESS;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_MODIFY_ADDRESS].y && y<figButton[ID_FIG_DIST_MODIFY_ADDRESS].y+figButton[ID_FIG_DIST_MODIFY_ADDRESS].height)
    {
        if(x>figButton[ID_FIG_DIST_MODIFY_ADDRESS].x && x<figButton[ID_FIG_DIST_MODIFY_ADDRESS].x+figButton[ID_FIG_DIST_MODIFY_ADDRESS].width)
        {
            motion=ID_FIG_DIST_MODIFY_ADDRESS;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else
    {
        motion=ID_FIG_NONE;
    }

    panelSetButton->Refresh();
}


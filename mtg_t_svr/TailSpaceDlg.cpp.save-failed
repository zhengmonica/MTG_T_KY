TailSpaceDlg::TailSpaceDlg( wxWindow* parent, wxWindowID id, const wxString& title, const wxPoint& pos, const wxSize& size, long style ) : wxDialog( parent, id, title, pos, size, style )
{
	//(*Initialize(TailSpaceDlg)
	//Create(parent, id, wxEmptyString, wxDefaultPosition, wxDefaultSize, wxDEFAULT_DIALOG_STYLE, _T("id"));
	this->SetSizeHints(wxDefaultSize,wxDefaultSize);
	this->Centre(wxBOTH);
	int w,h;
	int x1,y1,x2,y2;
	int w1,h1,w2,h2;
	this->GetClientSize(&w,&h);
	wxFont normalFont(11,wxFONTFAMILY_DEFAULT,wxFONTSTYLE_NORMAL,wxFONTWEIGHT_NORMAL,false,_("宋体"),wxFONTENCODING_DEFAULT);
	panelTitle=new MDTitle(this,wxID_ANY,wxPoint(0,0),wxSize(w,31),wxTAB_TRAVERSAL,_T("wxID_ANY"));
	panelTitle->IsMaximinize=1;
	panelTitle->m_close_box=1;
	panelTitle->Name=_("盾尾间隙");
	panelButtonList=new MDButtonList(this,wxID_ANY,wxPoint(0,31),wxSize(150,h-76), wxTAB_TRAVERSAL, _T("ID_PANEL2"));
	panelMain = new wxPanel(this, wxID_ANY, wxPoint(150,31), wxSize(w-150,h-76), wxTAB_TRAVERSAL, _T("wxID_ANY"));
    panelNavi = new wxPanel(panelMain, wxID_ANY, wxPoint(600+w,10), wxSize(160,h-90), wxTAB_TRAVERSAL, _T("wxID_ANY"));

    x1=0;
    y1=11;
    w1=w-150;
    h1=h-88;
    panelComm=new wxPanel(panelMain,wxID_ANY,wxPoint(x1,y1),wxSize(w1,h1),wxTAB_TRAVERSAL,_T("wxID_ANY"));
    panelComm->SetBackgroundColour(wxColor(239,239,239));

    x1=14;
    y1=9;
    w2=w1-x1*2;
    comStaticText1 = new wxStaticText(panelComm, wxID_ANY, _("测距仪通讯参数"), wxPoint(x1,y1), wxDefaultSize, 0, _("wxID_ANY"));
    comStaticLine1 = new wxStaticLine(panelComm, wxID_ANY, wxPoint(x1+50,y1+8), wxSize(w2-50,-1), wxLI_HORIZONTAL, _T("wxID_ANY"));
    y1+=30;
    comStaticText2 = new wxStaticText(panelComm, wxID_ANY, _("通讯类型"), wxPoint(x1,y1), wxDefaultSize, 0, _("wxID_ANY"));
    panelTarType = new wxPanel(panelComm, wxID_ANY, wxPoint(x1+65,y1-3), wxSize(260,23), wxTAB_TRAVERSAL, _T("wxID_ANY"));

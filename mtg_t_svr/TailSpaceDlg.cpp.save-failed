void TailSpaceDlg::OnMotionSetButton(wxMouseEvent& event)
{
    int x=event.GetX();
    int y=event.GetY();
    if(y>figButton[ID_FIG_DIST_ADD].y && y<figButton[ID_FIG_DIST_ADD].y+figButton[ID_FIG_DIST_ADD].height)
    {
        if(x>figButton[ID_FIG_DIST_ADD].x && x<figButton[ID_FIG_DIST_ADD].x+figButton[ID_FIG_DIST_ADD].width)
        {
            motion=ID_FIG_DIST_ADD;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_EDI].y && y<figButton[ID_FIG_DIST_EDI].y+figButton[ID_FIG_DIST_EDI].height)
    {
        if(x>figButton[ID_FIG_DIST_EDI].x && x<figButton[ID_FIG_DIST_EDI].x+figButton[ID_FIG_DIST_EDI].width)
        {
            motion=ID_FIG_DIST_EDI;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else if(y>figButton[ID_FIG_DIST_DEL].y && y<figButton[ID_FIG_DIST_DEL].y+figButton[ID_FIG_DIST_DEL].height)
    {
        if(x>figButton[ID_FIG_DIST_DEL].x && x<figButton[ID_FIG_DIST_DEL].x+figButton[ID_FIG_DIST_DEL].width)
        {
            motion=ID_FIG_DIST_DEL;
        }
        else
        {
            motion=ID_FIG_NONE;
        }
    }
    else
    {
        motion=ID_FIG_NONE;
    }

    panelSetButton->Refresh();
}

void TailSpaceDlg::OnLeaveSetButton(wxMouseEvent& event)
{
    motion=ID_FIG_NONE;
    panelSetButton->Refresh();
}

void ID_converse(wxString str,int &ID)
{
    str.MakeUpper();
    char cmd[2];
    strncpy(cmd,str.mb_str(wxConvUTF8),2);
    ID=0;
    for(int i=0;i<2;i++)
    {
        if(i!=1)
        {
            if(cmd[i]>='A'&&cmd[i]<='F')
                ID=(ID+(cmd[i]-'A')+10)*16;
            else if(cmd[i]>='0'&&cmd[i]<='9')
                ID=(ID+(cmd[i]-'0'))*16;
            wxMessageBox(wxString::Format(_("%d"),ID));
        }
        else
        {
            if(cmd[i]>='A'&&cmd[i]<='F')
                ID=(ID+(cmd[i]-'A')+10);
            else if(cmd[i]>='0'&&cmd[i]<='9')
                ID=(ID+(cmd[i]-'0'));
            wxMessageBox(wxString::Format(_("%d"),ID));
        }
    }
}

void TailSpaceDlg::OnClickSetButton(wxMouseEvent& event)
{
    if(motion==ID_FIG_DIST_ADD)
    {
        DistDlg dlg(this);
        dlg.Center();
        dlg.ptName->SetFocus();
        if(dlg.ShowModal()==wxID_OK)
        {
            mtg->ts.nSensor++;
            mtg->ts.dist=(double*)realloc(mtg->ts.dist,sizeof(double));
            mtg->ts.angle=(double*)realloc(mtg->ts.angle,sizeof(double));
            mtg->ts.stat=(int*)realloc(mtg->ts.stat,sizeof(int));
            wxString str;
            str=dlg.ptName->GetValue();
            //strncpy(b.name,str.mb_str(wxConvUTF8),64);
            int ID;
            ID_converse(str,ID);
            mtg->ts.ID[mtg->ts.nSensor-1]=ID;
            //wxMessageBox(wxString::Format(_("%0X"),mtg->ts.ID[mtg->ts.nSensor-1]));
            dlg.ptAngle->GetValue().ToDouble(&mtg->ts.angle[mtg->ts.nSensor-1]);
            mtg->ts.angle[mtg->ts.nSensor-1]=mtg->ts.angle[mtg->ts.nSensor-1]*PI/180.0;
            UpdateDistList();
            panelGraph->Refresh();

            /*if(mtg_add_dist(mtg,&b))
            {
                WriteMsg(_("增加测距仪成功"),0);
                UpdateDistist();
            }
            else
            {
                WriteMsg(_("增加测距仪失败"),1);
            }*/
        }
    }
    else if(motion==ID_FIG_DIST_EDI)
    {
        int sel = panelList->GetFirstSelected();
        if(sel<0) return;
        DistDlg dlg(this);
        dlg.Center();
        dlg.ptName->SetValue(wxString::Format(_("%0X"),mtg->ts.ID[sel]));
        dlg.ptAngle->SetValue(wxString::Format(_("%.4f"),mtg->ts.angle[sel]*180/PI));

        if(dlg.ShowModal()==wxID_OK)
        {
            wxString str;
            str=dlg.ptName->GetValue();
            //strncpy(b.name,str.mb_str(wxConvUTF8),64);
            int ID;
            ID_converse(str,ID);
            mtg->ts.ID[sel]=ID;
            dlg.ptAngle->GetValue().ToDouble(&mtg->ts.angle[sel]);
            UpdateDistList();

            /*if(mtg_modify_basket(mtg,sel,&b))
            {
                WriteMsg(_("编辑测距仪成功！"),0);
                UpdateDistList();
            }
            else
            {
                WriteMsg(_("编辑测距仪失败！"),1);
            }*/
        }
        motion=ID_FIG_NONE;
    }
    else if(motion==ID_FIG_DIST_DEL)
    {
        int sel = panelList->GetFirstSelected();
        if(sel<0) return;
        ConfirmDlg dlg(this);
        dlg.confirmMsg=_("确定删除")+wxString::Format(_("%d号位置"),sel+1)+_("测距仪吗？");
        dlg.Center();
        if(dlg.ShowModal()==wxID_OK)
        {
            for(int i=sel;i<panelList->GetItemCount();i++)
            {
                mtg->ts.ID[i]=mtg->ts.ID[i+1];
                mtg->ts.angle[i]=mtg->ts.angle[i+1];
                mtg->ID[i]=mtg->ID[i+1];
            }
            mtg->ts.nSensor--;
            UpdateDistList();
            /*if(mtg_remove_basket(mtg,sel))
            {
                WriteMsg(_("删除吊篮成功！"),0);
                UpdateDistList();
            }
            else
            {
                WriteMsg(_("删除吊篮失败！"),1);
            }*/
        }
    }
    else if(motion==ID_FIG_DIST_OBTAIN_ADDRESS)
    {
        int sel = panelList->GetFirstSelected();
        if(sel<0) sel=-1;
        if(sel>=0)
        {
            if(!distsvr_read(mtg,sel))
            {
                WriteMsg(wxString::Format(_("获取%d号位置测距仪的设备地址成功!"),sel),0);
                UpdateDistList();
            }
            else
                WriteMsg(wxString::Format(_("获取%d号位置测距仪的设备地址失败!"),sel),1);
        }
        else
        {
            if(!distsvr_read(mtg,sel))
            {
                WriteMsg(wxString::Format(_("获取所有测距仪的当前设备地址成功!")),0);
                UpdateDistList();
            }
            else
                WriteMsg(wxString::Format(_("获取所有位置测距仪的当前设备地址失败!")),1);
        }
    }
    else if(motion==ID_FIG_DIST_MODIFY_ADDRESS)
    {
        int sel = panelList->GetFirstSelected();
        if(sel<0) return;
        if(!distsvr_write(mtg,mtg->ID[sel],mtg->ts.ID[sel]))
        {
            WriteMsg(wxString::Format(_("设置%d号位置测距仪的理论设备地址成功!"),sel),0);
            mtg->ts.ID[sel]=mtg->ID[sel];
            UpdateDistList();
        }
        else
            WriteMsg(wxString::Format(_("设置%d号位置测距仪的理论设备地址失败!"),sel),1);
    }
    panelSetButton->Refresh();
}

void TailSpaceDlg::OnPaintGraph(wxPaintEvent& event)
{
   wxPaintDC dc(panelGraph);
   int w,h;
   panelGraph->GetClientSize(&w,&h);
   wxBitmap m_memBit;
    m_memBit.Create(w,h);
    if(m_memBit.IsOk())
    {
        wxMemoryDC memDC;
        memDC.SelectObject(m_memBit);
        ///background
        memDC.SetPen(wxPen(wxColor(130,135,145)));
        memDC.SetBrush(wxBrush(wxColor(255,255,255)));
        memDC.DrawRectangle(0,0,w,h);


        dc.Blit(0,0,w,h,&memDC,0,0);
    }
}

void TailSpaceDlg::OnListActivated(wxListEvent& event)
{
    wxMouseEvent e;
    motion=ID_FIG_DIST_EDI;
    OnClickSetButton(e);
}


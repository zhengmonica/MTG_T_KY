<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="LibPlc" />
		<Option pch_mode="2" />
		<Option compiler="msvc8" />
		<Build>
			<Target title="Win32 Release">
				<Option output="../bin32/LibPlc" prefix_auto="1" extension_auto="1" />
				<Option object_output="/Release" />
				<Option type="3" />
				<Option compiler="msvc8" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/MD" />
					<Add option="/O2" />
					<Add option="/W3" />
					<Add option="/GX" />
					<Add option="/FD" />
					<Add option="/FR" />
					<Add option="/DWIN32" />
					<Add option="/DNDEBUG" />
					<Add option="/D_WINDOWS" />
					<Add option="/D_WINDLL" />
					<Add option="/D_MBCS" />
					<Add option="/D_USRDLL" />
					<Add option="/DLIBPLC_MAKINGDLL" />
					<Add option="/D_AFXDLL" />
					<Add directory="C:/VC6/VC98/atlmfc/atlmfc/include" />
					<Add directory="../libmtg" />
					<Add directory="../gtime" />
					<Add directory="../libroad" />
					<Add directory="../libtps" />
					<Add directory="../stream" />
					<Add directory="../../../VC2008/atlmfc/include" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="C:/VC6/VC98/atlmfc/atlmfc/include" />
					<Add directory="../../../VC2008/atlmfc/include" />
				</ResourceCompiler>
				<Linker>
					<Add option="/subsystem:windows" />
					<Add option="/dll" />
					<Add option="/machine:I386" />
					<Add directory="C:/VC6/VC98/atlmfc/atlmfc/lib" />
					<Add directory="../../../VC2008/atlmfc/lib" />
				</Linker>
			</Target>
			<Target title="Win32 Debug">
				<Option output="../bin/Debug/LibPlc" prefix_auto="1" extension_auto="1" />
				<Option object_output="Debug" />
				<Option type="3" />
				<Option compiler="msvc8" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/Gm" />
					<Add option="/Od" />
					<Add option="/W3" />
					<Add option="/ZI" />
					<Add option="/MTd" />
					<Add option="/GX" />
					<Add option="/FD" />
					<Add option="/GZ" />
					<Add option="/DWIN32" />
					<Add option="/D_DEBUG" />
					<Add option="/D_WINDOWS" />
					<Add option="/D_WINDLL" />
					<Add option="/D_MBCS" />
					<Add option="/D_USRDLL" />
					<Add option="/DLIBPLC_MAKINGDLL" />
					<Add directory="C:/vc/VC2008/atlmfc/include" />
					<Add directory="../libmanager" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="C:/vc/VC2008/atlmfc/include" />
				</ResourceCompiler>
				<Linker>
					<Add option="/subsystem:windows" />
					<Add option="/dll" />
					<Add option="/debug" />
					<Add option="/machine:I386" />
					<Add option="/pdbtype:sept" />
					<Add directory="C:/vc/VC2008/atlmfc/lib" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="LibPlc.cpp" />
		<Unit filename="LibPlc.h" />
		<Unit filename="LibPlc.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="ReadMe.txt" />
		<Unit filename="Resource.h" />
		<Unit filename="StdAfx.cpp" />
		<Unit filename="StdAfx.h" />
		<Unit filename="callback.cpp" />
		<Unit filename="callback.h" />
		<Unit filename="pre_opc.cpp" />
		<Unit filename="res/LibPlc.rc2" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
